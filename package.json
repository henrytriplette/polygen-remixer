{
  "name": "polygen-remixer",
  "productName": "Remix Studio",
  "description": "A sampler / beat machine that sits between a DJ sampler and a drum machine.",
  "author": "Henry Triplette",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "yarn dev",
    "dev": "vite --config ./config/vite.config.dev.ts --host --mode development",
    "build": "vue-tsc -b && yarn build:prod",
    "build:dev": "vite build --config ./config/vite.config.dev.ts --mode development",
    "build:prod": "vite build --config ./config/vite.config.prod.ts --mode production",
    "preview": "vite preview",
    "build:electron": "vite build --config ./config/vite.config.electron.ts --mode production",
    "electron:start": "yarn build:electron && electron .",
    "electron:icon": "electron build/make-icon.cjs",
    "dist:win": "yarn build:electron && electron-builder --win portable"
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.8"
  },
  "build": {
    "appId": "com.henrytriplette.remixstudio",
    "productName": "Remix Studio",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "dist-electron/renderer/**/*",
      "build/icon.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "RemixStudio-${version}-portable.exe"
    }
  }
}
